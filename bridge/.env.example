# ============================================
# Outlook Bridge Configuration
# ============================================

# URL du backend CRM
BACKEND_URL=https://corevision-api.onrender.com/make-server-cac859af

# ID unique du device (pour détecter les doublons cross-device)
DEVICE_ID=device-001

# Intervalle de synchronisation en secondes
SYNC_INTERVAL=30

# ============================================
# Réseau (optionnel)
# ============================================

# Adresse IP d'écoute:
# - 0.0.0.0 : Accessible depuis n'importe quel ordinateur (DÉFAUT)
# - 127.0.0.1 : Seulement depuis cet ordinateur
BRIDGE_HOST=0.0.0.0

# Port du Bridge
BRIDGE_PORT=5001
