# CoreVision - Development Environment
# Used when running backend locally with PocketBase

# ─── PocketBase Configuration ─────────────────────────────────────────
POCKETBASE_URL=http://localhost:8090
PB_ADMIN_EMAIL=admin@corevision.local
PB_ADMIN_PASSWORD=AdminCoreVision2026!

# ─── JWT Configuration ───────────────────────────────────────────────
JWT_SECRET=dev_secret_key_change_in_production_12345

# ─── Environment ──────────────────────────────────────────────────────
NODE_ENV=development
DENO_ENV=development

# ─── Frontend URL (for CORS) ──────────────────────────────────────────
# Dev: Local Vite
FRONTEND_URL=http://localhost:5173
# Production: Vercel
# FRONTEND_URL=https://corevision-main.vercel.app

# ─── Assistant IA (LLM local via Ollama - aucune clé API, rien ne sort
# de cette machine) ────────────────────────────────────────────────────
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=gemma4:latest

# ─── Server Port ──────────────────────────────────────────────────────
PORT=3000
