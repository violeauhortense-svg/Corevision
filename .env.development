# CoreVision - Development Environment
# Used when running backend locally with PocketBase

# ─── PocketBase Configuration ─────────────────────────────────────────
# Dev: Local PC via Tailscale
POCKETBASE_URL=http://pc1.tailscale:8090

# ─── JWT Configuration ───────────────────────────────────────────────
JWT_SECRET=dev_secret_key_change_in_production_12345

# ─── Environment ──────────────────────────────────────────────────────
NODE_ENV=development
DENO_ENV=development

# ─── Frontend URL (for CORS) ──────────────────────────────────────────
# Dev: Local Vite
FRONTEND_URL=http://localhost:5173
# Production: Vercel
# FRONTEND_URL=https://corevision-main.vercel.app

# ─── AI/API Keys (optional for dev) ───────────────────────────────────
# OPENAI_API_KEY=sk-...  # Add if needed for AI features in dev

# ─── Server Port ──────────────────────────────────────────────────────
PORT=3000
